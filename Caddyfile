{$SITE_DOMAIN} {
  encode zstd gzip

  header {
    Strict-Transport-Security "max-age=31536000; includeSubDomains"
    X-Content-Type-Options "nosniff"
    X-Frame-Options "DENY"
    Referrer-Policy "strict-origin-when-cross-origin"
    Permissions-Policy "camera=(), microphone=(), geolocation=()"
    # Players (Dood, VOE, EarnVids) move to new domains without notice: the
    # embed URL redirects to a rotating domain when the video starts, and a
    # fixed frame-src list blocked it ("This content is blocked"). So any
    # HTTPS frame is allowed; the known list stays as a report-only policy,
    # so browsers report each new player domain to /api/csp-report (listed
    # in /admin/hosts) without blocking the video.
    Reporting-Endpoints `csp="https://{$SITE_DOMAIN}/api/csp-report"`
    Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data: blob: https:; font-src 'self' https://fonts.gstatic.com; connect-src 'self'; media-src 'self' https:; frame-src 'self' https:; report-uri /api/csp-report; report-to csp"
    Content-Security-Policy-Report-Only "frame-src 'self' https://dood.la https://dood.pm https://dood.so https://dood.to https://dood.watch https://doodstream.com https://morencius.com https://myvidplay.com https://playmogo.com https://voe.sx; report-uri /api/csp-report; report-to csp"
  }

  # Thumbnails are written once per video id and change only when an admin
  # picks another one, which the ?v= cache-buster on thumbnail URLs covers.
  handle_path /media/* {
    header Cache-Control "public, max-age=31536000, immutable"
    root * /srv/media
    file_server
  }

  handle {
    reverse_proxy web:3000
  }
}

# Other sites served by this same Caddy are not part of this repository: one
# file per site in caddy-sites/ on the server (gitignored), mounted at
# /etc/caddy/sites. Add or change them there, never in this file (a deploy
# overwrites it). A glob that matches nothing is only a warning, so an empty
# folder is fine; files starting with "." are skipped.
import /etc/caddy/sites/*.caddy
