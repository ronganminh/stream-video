SITE_DOMAIN=video.example.com

POSTGRES_DB=gayvideo
POSTGRES_USER=gayvideo
POSTGRES_PASSWORD=CHANGE_ME_WITH_A_URL_SAFE_RANDOM_VALUE
POSTGRES_PORT=5432

DATABASE_URL="postgresql://gayvideo:CHANGE_ME_WITH_A_URL_SAFE_RANDOM_VALUE@postgres:5432/gayvideo?schema=public"
BUILD_DATABASE_URL="postgresql://gayvideo:CHANGE_ME_WITH_A_URL_SAFE_RANDOM_VALUE@127.0.0.1:5432/gayvideo?schema=public"

ADMIN_SESSION_SECRET=CHANGE_ME_WITH_AT_LEAST_32_RANDOM_BYTES

HOST_DOOD_API_KEY=
HOST_DOOD_EMBED_BASE=https://playmogo.com
HOST_VOE_API_KEY=
HOST_EARNVIDS_API_KEY=

# Posting to X (@Gayvideofun) through Buffer; see docs/API.md. Empty key =
# X posts are queued but nothing is sent. Never commit the real key.
BUFFER_API_KEY=
BUFFER_X_HANDLE=Gayvideofun
# Optional: found from the handle when empty (npm run social:channels).
BUFFER_X_CHANNEL_ID=
BUFFER_ORGANIZATION_ID=
# Buffer Free keeps 10 scheduled posts per channel; ~1000 API requests/month.
BUFFER_QUEUE_LIMIT=10
# Queue cycles: every BUFFER_SYNC_PEAK_MINUTES inside BUFFER_PEAK_HOURS (local
# BUFFER_TIMEZONE, when Buffer posts), else every BUFFER_SYNC_MINUTES. A cycle
# with nothing to do makes no request. Buffer is read (to confirm posts went
# out) at most every BUFFER_CONFIRM_MINUTES; between reads the queue room
# comes from the due times Buffer gave our posts.
BUFFER_SYNC_MINUTES=120
BUFFER_SYNC_PEAK_MINUTES=30
BUFFER_PEAK_HOURS=17-24
BUFFER_TIMEZONE=Asia/Ho_Chi_Minh
BUFFER_CONFIRM_MINUTES=180
# Clip length for X: 120 s on a normal account; raise it (or 0 = full video) with Premium.
X_CLIP_SECONDS=120
X_CLIP_MAX_MB=512
# "Giữ nguyên" (keep the whole video) in /admin/review is cut to this: free X
# accounts take ~140 s; raise it after upgrading to Premium.
X_MAX_VIDEO_SECONDS=140
# Starts the X clip workflow (.github/workflows/x-clips.yml) after approvals
# in /admin/review. Fine-grained PAT, Actions: write on this repository only.
# Set by the deploy workflow from the GAYVIDEO_CLIP_DISPATCH Actions secret.
GAYVIDEO_CLIP_DISPATCH=
X_CLIPS_REPOSITORY=ronganminh/stream-video
# Wait this long after the last approval, so a burst starts one run.
X_CLIPS_DEBOUNCE_SECONDS=90

MEDIA_DIR=/data/media
